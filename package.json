{
  "name": "navalhado-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "Back",
    "Front"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:back\" \"npm run dev:front\"",
    "dev:back": "npm --prefix Back run dev",
    "dev:front": "npm --prefix Front run dev -- --host 0.0.0.0",
    "build": "npm --prefix Front run build",
    "start": "npm --prefix Back run start",
    "check": "node --check Back/server.js && npm --prefix Front run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
